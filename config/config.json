{
    "PcfName": "R2S_PNZ",
    "ReferenceFrame": "ITRF2020",
    "ReferenceStationCoordinateFile": "STA/REFSTNS.CRD",
    "ReferenceCoordinateProcessingStrategy": "d20f_54_code_A+d20f_52_code_A+p20r_54_code",
    "OutputStatusFile": "OUT/STATUS.LCK",
    "OutputSummaryJson": "OUT/SUMMARY.JSON",
    "ParameterSets": {
        "RAPID": {
            "V_ORBTYP": "COD_RAP",
            "V_OSBTYP": "COD_RAP",
            "V_IONTYP": "COD_RAP"
        },
        "RAPID_PLUS": {
            "V_ORBTYP": "COD_FIN/COD_RAP",
            "V_OSBTYP": "COD_FIN/COD_RAP",
            "V_IONTYP": "COD_FIN/COD_RAP"
        },
        "FINAL": {
            "V_ORBTYP": "COD_FIN",
            "V_OSBTYP": "COD_FIN",
            "V_IONTYP": "COD_FIN"
        }
    },
    "ConfigOutputFiles": [
        {
            "source": "output_files/readme.txt",
            "target": "readme.txt",
            "description": "Information about these results"
        }
    ],
    "CampaignOutputFiles": [
        {
            "source": "SOL/MIN_{YYYY}{session}.SNX",
            "target": "min_{origcodes}_{jobcode}_{subjobid}.snx",
            "description": "SINEX file of minimum constraints calculation for {origcodes} ({origfiles})"
        },
        {
            "source": "SOL/FIN_{YYYY}{session}.SNX",
            "target": "fin_{origcodes}_{jobcode}_{subjobid}.snx",
            "description": "SINEX file of final coordinate calculation for {origcodes} ({origfiles})"
        }
    ],
    "ReferenceDataFiles": {
        "AntennaFile": "NGS20.ATX",
        "ReceiverFile": "RECEIVER.",
        "ExtraReceiverConfigFile": "config/RECEIVER.MISSING",
        "CombinedReceiverFile": "RECEIVER.ALL"
    }
}
