package AMBXTR;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  AMBXTR
#
# Purpose :  Create comprehensive ambiguity resolution summary
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(appFile setGNSS);
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyyyssss, $satsysAR,
      $lenAmb, $lenQIF, $lenL53, $lenL12,
      $dirOut, $extOut, $dirSum, $extSum) =
  $bpe->getKeys
     ('$YYYSS+0', 'V_GNSSAR',
      'V_BL_AMB','V_BL_QIF','V_BL_L53','V_BL_L12',
      'DIR_OUT','EXT_OUT','DIR_SUM','EXT_SUM');

# Initialize processing summary file
# ----------------------------------
  my $sumFil = "${dirSum}AMB_${yyyyssss}.${extSum}";
  unlink $sumFil;
  my $tmpFil = "${dirSum}TMP_${yyyyssss}.${extSum}";
  unlink $tmpFil;
  my $outFil = "${dirOut}TMP_${yyyyssss}.${extOut}";
  unlink $outFil;

# Run program
# -----------
  my $PGMNAM = "GPSXTR";

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBLOD","1");

# Code-Based Widelane (WL) Ambiguity Resolution
# ---------------------------------------------
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'WLI_$YYYSS+0_????');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","QIFOUT",$tmpFil);

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","WL");
  $bpe->RUN_PGMS($PGMNAM);

  if (-s $tmpFil) {
     appFile(" Code-Based Widelane (WL) Ambiguity Resolution (<${lenAmb} km)",
       0,$tmpFil,$sumFil,1);
    unlink $tmpFil }

# Code-Based Narrowlane (NL) Ambiguity Resolution
# -----------------------------------------------
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'NLI_$YYYSS+0_????');

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","NL");
  $bpe->RUN_PGMS($PGMNAM);
  if (-s $tmpFil) {
     appFile(" Code-Based Narrowlane (NL) Ambiguity Resolution (<${lenAmb} km)",
       0,$tmpFil,$sumFil,1);
    unlink $tmpFil }

# Phase-Based Widelane (L5) Ambiguity Resolution
# ----------------------------------------------
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'WL5_$YYYSS+0_????');

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","L5");
  $bpe->RUN_PGMS($PGMNAM);
  if (-s $tmpFil) {
     appFile(" Phase-Based Widelane (L5) Ambiguity Resolution (<${lenL53} km)",
       0,$tmpFil,$sumFil,1);
    unlink $tmpFil }

# Phase-Based Narrowlane (L3) Ambiguity Resolution
# ------------------------------------------------
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'NL3_$YYYSS+0_????');

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","L3");
  $bpe->RUN_PGMS($PGMNAM);
  if (-s $tmpFil) {
     appFile(" Phase-Based Narrowlane (L3) Ambiguity Resolution (<${lenL53} km)",
       0,$tmpFil,$sumFil,1);
    unlink $tmpFil }

# Quasi-Ionosphere-Free (QIF) Ambiguity Resolution
# ------------------------------------------------
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'QIF_$YYYSS+0_????');

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","QIF");
  $bpe->RUN_PGMS($PGMNAM);
  if (-s $tmpFil) {
     appFile(" Quasi-Ionosphere-Free (QIF) Ambiguity Resolution (<${lenQIF} km)",
       0,$tmpFil,$sumFil,1);
    unlink $tmpFil }

# Direct L1/L2 Ambiguity Resolution
# ---------------------------------
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'L12_$YYYSS+0_????');

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","L12");
  $bpe->RUN_PGMS($PGMNAM);
  if (-s $tmpFil) {
     appFile(" Direct L1/L2 Ambiguity Resolution (<${lenL12} km)",
       0,$tmpFil,$sumFil,1);
    unlink $tmpFil }

    

# Set the GNSS to be used
# -----------------------
  setGNSS($bpe,"$ENV{U}/PAN/OBSXTR.INP","USE_",$satsysAR);


# Overall Ambiguity Resolution Statistics
# ---------------------------------------
  $bpe->putKey("$ENV{U}/PAN/OBSXTR.INP","SYSOUT",$outFil);
  $bpe->putKey("$ENV{U}/PAN/OBSXTR.INP","SUMFIL",$tmpFil);

  my $PGMNAM = "OBSXTR";
  $bpe->RUN_PGMS($PGMNAM);

  if (-s $tmpFil) {
     appFile(" Station-wise Ambiguity Resolution Statistics",
       0,$outFil,$sumFil,1);
     unlink $outFil;
     appFile(" Satellite-wise Ambiguity Resolution Statistics",
       0,$tmpFil,$sumFil,1);
    unlink $tmpFil }

}
