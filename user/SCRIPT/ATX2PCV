package ATX2PCV;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  ATX2PCV
#
# Purpose :  Execute ATX2PCV
#            Update the antenna phase center eccentricity (PCV) file if required
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#            20-Jun-2022 LP: Remove outdated paths from comments
#            07-Sep-2022 AV: Update location of old PCV file
#
# ============================================================================
use strict;

use File::Copy;
use File::Compare;
use lib "$ENV{BPE}";
use bpe_util qw(prtMess);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($myAtx, $pcvInf, $pcv,
      $dirPhaecc, $extPhaecc, $dirOut) =
    $bpe->getKeys(
      'V_MYATX', 'V_PCVINF', 'V_PCV',
      'PTH_PHASECC', 'EXT_PHASECC', 'DIR_OUT');

# Was an ATX specified?
# ---------------------
  if ( $myAtx eq "" || ! -e "${dirPhaecc}/${myAtx}" ) {
    prtMess($bpe,"No ANTEX file for update");
  } else {
    prtMess($bpe,"Use file $myAtx for update");
    copy("${dirPhaecc}/${myAtx}","${dirOut}");

# Run program
# -----------
    my $PGMNAM = "ATX2PCV";
    $bpe->RUN_PGMS($PGMNAM);


# Update the phase center (PCV) file if there is new information
# --------------------------------------------------------------
    my $pcvOld = "${dirPhaecc}/${pcvInf}_${pcv}.${extPhaecc}";
    my $pcvNew = $bpe->getKey("$ENV{U}/INP/ATX2PCV.INP","PHASRSG");

    if (compare("$pcvOld","$pcvNew",   # Copare but remove the creation date
        sub {my $a = $_[0]; my $b = $_[1];
             $a =~ s/[0-9][0-9]-[A-Z][A-Z][A-Z]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]$//;
             $b =~ s/[0-9][0-9]-[A-Z][A-Z][A-Z]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]$//;
             $a ne $b} ) != 0) {
      copy("$pcvNew","$pcvOld");
      prtMess($bpe,"Copy new Bernese phase eccenter file: ${pcvOld}");
    }
  }

}
