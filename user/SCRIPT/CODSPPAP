package CODSPPAP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  CODSPPAP
#
# Purpose :  Prepare parallel CODSPP run
#
# PARAMs  :  PARAM2 - output file identifier (default: SPP)
#            PARAM3 - empty: stop if no CZH files are found
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#
# ============================================================================
use strict;

use File::Basename;

use lib $ENV{BPE};
use bpe_util qw(prtErr initPar_Bl initPar_Cl cleanFiles);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss    , $yyyyssss  ,
      $param3  , $clu     , $dirBpe,
      $dirCzh  , $extCzh    ) =
  $bpe->getKeys
     ('$S+0'   , '$YYYSS+0' ,
      'PARAM3' , 'V_CLU'  , 'DIR_BPEPRT',
      'DIR_CZH', 'EXT_CZH');

# Delete old output files
# -----------------------
  cleanFiles($bpe,"SPP",["OUT","CRD"], $clu);

# Initialize parallel run
# -----------------------
  my $bpeFil = "${dirBpe}SPP_${yyyyssss}_";
  my @czhFil = glob("${dirCzh}????${ssss}.${extCzh}");

  if ($clu ne "") {
    initPar_Cl($bpe,$bpeFil,@czhFil,0,$clu,0, ($clu));
  } else {
    @czhFil = map { substr(basename($_),0,4) } @czhFil;
    initPar_Bl($bpe,@czhFil);
  }

# Stop if no CZH files found
# --------------------------
  if (@czhFil == 0 && $param3 eq "") {
    prtErr($bpe,"No CZH files found") and
      die "No CZH files found for session ${ssss}";
  }

}
