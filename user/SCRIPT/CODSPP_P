package CODSPP_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  CODSPP_P
#
# Purpose :  Execute CODSPP (parallel mode)
#
# PARAMs  :  PARAM1 - temporary file for parallel processing
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(prtMess setClusterVar replaceSel prtBPEfile);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyyyssss, $ssss,
      $param1, $clu ) =
  $bpe->getKeys
     ('$YYYSS+0', '$S+0',
      'PARAM1', 'PARAM2');

# Set cluster number and input files
# ----------------------------------
  my $mess = setClusterVar($bpe, $clu);
  prtMess($bpe,"$mess");

# Selected files
# --------------
  if ($clu eq "") {
    $bpe->putKey("$ENV{U}/PAN/CODSPP.INP","CODEFILE","$param1$ssss");
  } else {
    replaceSel($bpe,"CODSPP","CODEFILE",$param1);
  }

# Run program
# -----------
  my $PGMNAM = "CODSPP";
  $bpe->RUN_PGMS($PGMNAM);

# Print processed stations BPE file
# ---------------------------------
  prtBPEfile($param1,0) if ($clu ne "");

}
