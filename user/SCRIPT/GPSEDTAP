package GPSEDTAP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GPSEDTAP
#
# Purpose :  Prepare parallel pre-processing: residual screening:
#            - Single-difference, phase measurements
#
# PARAMs  :  PARAM2 - output file identifier (default: V_C)
#            PARAM3 - empty: stop if no PZH files are found
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#            12-Jun-2023 RD: make sure that all files get deleted (disregarding PARAM2)
#
# ============================================================================
use strict;

use File::Basename;

use lib $ENV{BPE};
use bpe_util qw(initPar_Bl initPar_Cl prtErr cleanFiles);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyyyssss, $ssss,
      $clu, $clu2, $dirBpe, $c,
      $param2, $param3,
      $dirPsh,
      $extPsh) =
  $bpe->getKeys
     ('$YYYSS+0','$S+0',
      'V_CLU', 'V_CLUEDT', 'DIR_BPEPRT', 'V_C',
      'PARAM2', 'PARAM3',
      'DIR_PSH',
      'EXT_PSH');


# Delete old files (OUT, RES, NEQ, EDT)
# -------------------------------------
  $clu = $clu2 if $clu2 ne "";

# no $param2 is allowed here to delete the specific IDs from the list
  $$bpe{'PARAM2'} = '';

  cleanFiles($bpe,"EDF",  ["OUT","RES"], $clu);
  cleanFiles($bpe,"EDL",  ["OUT","RES"], $clu);
  cleanFiles($bpe,"RES",  ["OUT","EDT"], $clu);
  cleanFiles($bpe,"MRK",  ["OUT"], $clu);
  cleanFiles($bpe,$$bpe{$param2},["NEQ"], $clu);
  cleanFiles($bpe,"WRN",  ["SUM"], $clu);

# Initialize parallel run
# -----------------------
  my $bpeFil = "${dirBpe}EDT_${yyyyssss}_";

  my @obsFil = glob("${dirPsh}????${ssss}.${extPsh}");

  if ($clu ne "") {
    initPar_Cl($bpe,$bpeFil,@obsFil,0,$clu,0, ($clu));
  } else {
    @obsFil = map { substr(basename($_),0,4) } @obsFil;
    initPar_Bl($bpe,@obsFil);
  }

# Stop if no CZH files found
# --------------------------
  if (@obsFil == 0 && $param3 eq "") {
    prtErr($bpe,"No $extPsh files found") and
      die "No $extPsh files found for session ${ssss}";
  }

}
