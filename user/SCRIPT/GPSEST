package GPSEST;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GPSEST
#
# Purpose :  Execute GPSEST
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(setGNSS);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($satsys) = $bpe->getKeys('V_SATSYS');

# Selection of GNSS
# -----------------
  setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_",$satsys);

# Run program
# -----------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

}
