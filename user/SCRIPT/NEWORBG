package NEWORB;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  NEWORB
#
# Purpose :  Execute NEWORB for daily or hourly processing considerin a range
#            of sessions for hourly processing
#            Execute NEWORB shifting the session beginning back to a multiple
#            of the integration interval.  This ensures that NEWORB does not 
#            end up requesting data from the day after the current session, as
#            this data may not have been retrieved or tabulated...
#            Changing stochastic parameters depending on what orbit products 
#            are being used. 
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(prtMess isHourly setHourly setGNSS);
use LINZ::GNSS::Time qw/seconds_datetime/;
use LINZ::BERN::SessionFile;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss,$yyyy,$hourly,$satsys,$orb,$dirOrb,$dirses) = 
  $bpe->getKeys
  ('$S+0','$Y+0','V_HOURLY','V_SATSYS','V_ORB','DIR_IEP','DIR_SES');


# Get the session table and retrieve the start and end of the session
  my $sesstable=$dirses.'/'.$$bpe{SESSION_TABLE};
  my $sf=new LINZ::BERN::SessionFile($sesstable);
  my ($start,$end)=$sf->sessionStartEnd($ssss,$yyyy);
  
  # Calculate duration - number of hours - to be used in determining stochastic number
  my $duration = $end - $start;
  my $duration_hours   = int($duration / 3600);

# Check product files to determine if they are rapid or final this 
# will be used to set the V_STOCH_NUMBER dynamically - Text files 
# created by script ORBTYP
# ----------------------------------------------------------------
  my $ddd = substr($ssss,0,3);
  my $preFil = "${dirOrb}${orb}_${yyyy}${ddd}.PRE";
  my $stoch = 'Spacing';
  my $product = 'RAPID';

  print "Header of precise orbit file $preFil:\n";
  open(PRE,"$preFil") or die "cannot open $preFil: $!\n";
  while ( <PRE> ) {
    print "$_";
    # Note - these will fail if hardcoded headers don't have a comment line starting with rapid or final
    if ( /^\/\*\sRAPID\s/i ) {
     prtMess($bpe,"Precise orbit file read - found to be rapid product");
     $product = 'RAPID';
     last; 
    }
    elsif (/^\/\*\sFINAL\s/i ) {
      prtMess($bpe,"Precise orbit file read - found to be final product");
      $product = 'FINAL';
     last; 
   }
  }
  close PRE or die "cannot close $preFil: $!\n";

  if ( $duration_hours < 2 ) { $stoch = 'No_setup'; } 
  elsif ( $duration_hours >= 2 && $duration_hours < 10 ) { $stoch = 'Spacing'; } 
  elsif ( $duration_hours >= 10 && $product eq 'RAPID') { $stoch = 'Spacing';  }
  elsif ( $duration_hours >= 10 && $product eq 'FINAL') { $stoch = 'Orbit_midnight' }

# Set the GNSS to be used
# -----------------------
  if (! ($satsys =~ /G/) ) { $satsys = 'G'.$satsys; } 
  setGNSS($bpe,"$ENV{U}/PAN/ORBGEN.INP","USE_",$satsys);

# Adjust the settings on integration interval if V_STOCH_NUMBER is set
# --------------------------------------------------------------------
  my $leninter = $bpe->getKey("$ENV{U}/PAN/ORBGEN.INP","LENINTER");
  my $varlnint = $bpe->getKey("$ENV{U}/PAN/ORBGEN.INP","VARLNINT");

  # "Spacing" is used for rapid products and timespans less than 10 hours
  if ( $stoch eq "Spacing" && 
       $leninter eq "00 05 00" && $varlnint eq "01 00 00" ) {
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","LENINTER","01 00 00");
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","VARLNINT","06 00 00");
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STOCH_NUMBER","Spacing");
    prtMess($bpe,"Keywords LENINTER and VARNLINT adjusted for STOCHASTIC PULSES as \"$stoch\"");
  }
  # "Orbit_midnight" is used for final products time spans more than 10 hrs
  if ( $stoch eq "Orbit_midnight" && 
       $leninter eq "01 00 00" && $varlnint eq "06 00 00") {
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","LENINTER","00 05 00");
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","VARLNINT","01 00 00");
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STOCH_NUMBER","Orbit_midnight");
    prtMess($bpe,"Keywords LENINTER and VARNLINT adjusted for STOCHASTIC PULSES as \"$stoch\"");
  }
  if ( $stoch eq 'No_setup') {
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STOCH_NUMBER","No_setup");
    prtMess($bpe,"STOCH_NUMBER set to \"$stoch\" as data duration less than 2 hours");
  }

  # PNZORB steps added to ORBGEN standard process
  # Get the integration interval for the selected products
  # from above "LENINTER" will be 01 00 00 (1hr) for rapid products and 
  # 00 05 00 (5min) for final products 
 
  my $lenint=$bpe->getKey("$$bpe{U}/PAN/ORBGEN.INP","LENINTER");
  my($inth,$intm,$ints)=split(' ',$lenint);
  # gets the interval length in seconds specified (1hr for spacing, 5 mins for
  # orbit midnight)
  my $intsec=$ints+$intm*60+$inth*3600;

  # HASHED AS THESE HAVE ALREADY BEEN RUN AT BEGINNING OF SCRIPT
  # Get the session table and retrieve the start and end of the session
  # my $sesstable=$dirses.'/'.$$bpe{SESSION_TABLE};
  # my $sf=new LINZ::BERN::SessionFile($sesstable);
  # my ($start,$end)=$sf->sessionStartEnd($ssss,$yyyy);
  
  # Convert to 'YYYY MM DD HH MM SS'
  my $starts=seconds_datetime($start);
  $starts =~ s/\D/ /g;
  # start time in HH MM SS
  my $statim0=substr($starts,11,8);

  my ($stah,$stam,$stas)=split(' ',$statim0);
  # $stasec0 is start time in seconds
  my $stasec0=$stas+$stam*60+$stah*3600;
  # $stasec is how many whole intervals have already occurred that day when the
  # first epoch of data appears
  my $stasec=$intsec*int($stasec0/$intsec);
  # subtracts the difference in time between the last whole interval and the 
  # start time, to get the difference (this will be a negative number) and adds
  # it to the start time. The effect is to set the start time at an the nearest interval
  # to ensure the orbits are constrained appropriately at the start of the data.
  # $start will be before the actual start time of the data  
  # reminder $start is in unix time (seconds)
  $start += ($stasec-$stasec0);
  
  # I don't think this is needed anymore as we don't process sessions less than 15 mins
  #------------------------------------------------------------------------------------
  # Issue with orbgen generating error
  # 
  # NO TWO SATELLITE POSITIONS FOUND < 3 HOURS APART
  #
  # This seems to occur if the session is less than 15 mins (with the current settings).
  # So force end time to be at least 15 mins after start.  Not sure what factors could
  # change this value.
 
  #my $endmin=$start+15*60;
  #$end=$endmin if $end < $endmin;
  #------------------------------------------------------------------------------------

  $starts=seconds_datetime($start);
  $starts =~ s/\D/ /g;
  my $stadat=substr($starts,0,10);
  my $statim=substr($starts,11,8);

  my $ends=seconds_datetime($end);
  $ends =~ s/\D/ /g;
  my $enddat=substr($ends,0,10);
  my $endtim=substr($ends,11,8);

  prtMess($bpe,"Setting orbit time span to $stadat $statim - $enddat $endtim");

  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STADAT",$stadat);
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STATIM",$statim);

  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","ENDDAT",$enddat);
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","ENDTIM",$endtim);


# Run program
# -----------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

}
