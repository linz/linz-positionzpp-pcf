use strict;

use File::Copy qw(move copy);

use lib $ENV{BPE};
use bpe_util qw(isHourly setHourly copyRef copyFil copyGen setGNSS appFile mergeFile);
use lib "$ENV{EXE}";
use Gps_Date qw(gps_date);

sub run{
