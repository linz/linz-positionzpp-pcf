      $bpe->putKey("$ENV{U}/PAN/BIA2OSB.INP","BIASNX","${orb}_${myYYYYDDD}");
      $bpe->putKey("$ENV{U}/PAN/BIA2OSB.INP","OSBOUT","IAR_${myYYYYDDD}0");
      push @biaLst,"${dirOsb}IAR_${myYYYYDDD}0.${extOsb}";

