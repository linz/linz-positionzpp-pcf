  #  push @filLst,"${dirIon}${orb}_${myYYYYDDD}.${extIon} 0";
  #  push @ionLst,"${dirIon}${orb}_${myYYYYDDD}.${extIon}";
  #}

# Copy BSW-formatted input Files
# ------------------------------
  #copyRef($bswDir,@filLst);

# Copy/concatenate the ionosphere files
# -------------------------------------
#  if ( $hoiFil ne "" ) { # ionosphere model for HOI is available
#    $hoiFil = "${dirIon}${hoiFil}.${extIon}";

#    unlink "${hoiFil}_tmp";
#    map { appFile("",0,$_,"${hoiFil}_tmp",1) if -e $_; } reverse @ionLst;
#    unlink @ionLst;
#    unless ( -e "${hoiFil}_tmp" ) {
#      die("No ionosphere input file found n $bswDir to get $hoiFil\nExpected CODwwwd.ION, COD0OPSFIN_yyyyddd*GIM.ION")
#    }
#    move("${hoiFil}_tmp", "$hoiFil");
#  }

# Copy/concatenate the bias files
# -------------------------------
#  if ( -e $biaLst[0] ) { # OSB file with GNSS satellite biases available
#    $osbFil = "${dirOsb}${osbFil}.${extOsb}";

#    copy( $biaLst[0], "${osbFil}_tmp");
#    for (my $ii = 1; $ii <= $#biaLst; $ii++ ) {
#      mergeFile($biaLst[$ii-1],$biaLst[$ii],"${osbFil}_tmp","11");
#    }
#    unlink @biaLst;
#    move("${osbFil}_tmp", "$osbFil");
