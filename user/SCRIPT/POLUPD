package POLUPD;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  POLUPD
#
# Purpose :  Execute POLUPD for daily or hourly processing
#
# Remark  :  - Consider range of sessions for hourly processing
#            - USERATE is automatically adjusted according to the existence
#              of midnight epochs in the IERS pole file or not
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(setHourly);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($orb,$ssss,$hourly) = $bpe->getKeys('V_ORB','$S+0','V_HOURLY');

# Hourly processing
# -----------------
  setHourly($bpe);

# Run program
# -----------
  my $PGMNAM = "POLUPD";
  $bpe->RUN_PGMS($PGMNAM);

# Check whether the ERP must switched off
# ---------------------------------------
  my $iepFil = $bpe->getKey("$ENV{U}/INP/POLUPD.INP","IEPFIL");
  my $isRate = $bpe->getKey("$ENV{U}/INP/POLUPD.INP","USERATE");
  my $doRate = 1;

  open(IEP,"$iepFil");
  while ( <IEP> ) {
   if ( /^[ ]*([\d][\d][\d][\d][\d]\.[\d]*) / ) {
     my $epo = $1;
     if ( $epo == int($epo) ) {
       $doRate = 0;
       last;
     }
   }
  }
  close IEP;

# Repeat the program if necessary
# -------------------------------
  if ( $orb eq "XYZ" ) { $doRate = 1 }  # if products from "XYZ" are used
                                        # apply the polar rates.

  if ( $doRate != $isRate ) {
    $bpe->putKey("$ENV{U}/PAN/POLUPD.INP","USERATE","$doRate");

    my $PGMNAM = "POLUPD";
    $bpe->RUN_PGMS($PGMNAM);
  }
}
