package RNXGRA;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RNXGRA
#
# Purpose :  Execute RNXGRA
#
# Remark  :  delete incomplete RINEX observation files
#            if the correspsonding option in RNXGRA is enabled
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(prtGoto prtMess appFile deleteFiles setGNSS);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss,
      $param1, $param2, $satsys,
      $dirRxo, $extRxo) = 
  $bpe->getKeys(
      '$S+0',
      'PARAM1','PARAM2','V_SATSYS',
      'DIR_RXO','EXT_RXO');

# Set the GNSS to be used
# -----------------------
  setGNSS($bpe,"$ENV{U}/PAN/RNXGRA.INP","USE_",$satsys);

# Run program
# -----------
  my $PGMNAM = "RNXGRA";
  $bpe->RUN_PGMS($PGMNAM);

# Delete incomplete RINEX observation files
# -----------------------------------------
  if ( $bpe->getKey("$ENV{U}/INP/RNXGRA.INP","GETLST") eq "1" ) {
    my $sumFil = $bpe->getKey("$ENV{U}/INP/RNXGRA.INP","SUMMARY");
    my $delFil = $bpe->getKey("$ENV{U}/INP/RNXGRA.INP","DELFILE");
    appFile ("Files excluded from processing:",0,
             "$delFil","$sumFil",1) if (-e $delFil);
    deleteFiles($bpe,$delFil,1);
  }

# If no files available, jump to the end
# --------------------------------------
  if ( $param1 eq "NEXTJOB" ) {
    my @list = glob("${dirRxo}*");
    unless ( @list ) {
      print "No RINEX files left\n";
      prtMess($bpe,"No RINEX files left");
      $bpe->prtGoto($param2);
    }
  }
}
