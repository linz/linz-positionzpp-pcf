package SKIP_SES;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  SKIP_SES
#
# Purpose :  The BPE variable V_SKIP is assumed as the filename of the
#            sessions protocol file. If the related file:
#               V_SKIP
#            already exist the processing of the session comtinues at PID
#            given as PARAM2 what is typically the end of the BPE.
#
# PARAMs  :  PARAM2: PID where to jump when the session shall not be processed
#
# Author  :  R. Dach
# Created :  07-Jun-2022
#
# Changes :  07-Jun-2022 RD: Created for version 5.4
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(prtMess prtGoto);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss, $yyyy,
      $skip, $skip2,
      $param2 ) =
    $bpe->getKeys(
      '$S+0','$Y+0',
      'V_SKIP', $$bpe{V_SKIP},
      'PARAM2');

# V_SKIP may contain variables
# ----------------------------
  $skip = $skip2 if ($skip2 ne "");


# V_SKIP must be defined and may not be empty
# -------------------------------------------
  if ( $skip ne "" ) {

    # Reconstruct the name of the potenrial sessions protocol file
    my $prcFil = "${skip}";
    print "prcFil = :$prcFil:\n";
    
    # Skip session if the protocol file exists
    if ( -e $prcFil ) {
      prtMess($bpe,"Session skipped because the protocol file is available:");
      prtMess($bpe,$prcFil);
      prtGoto($bpe,$param2);
    } else {
      prtMess($bpe,"Continue processing session ${yyyy}-${ssss}");
    }
  
  }

}
